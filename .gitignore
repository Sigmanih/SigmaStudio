collatz_pipeline.json

# Virtual Environment
.venv/
projects/
sandboxes.json

# OS files
.DS_Store
Thumbs.db

# Database files (contain user data)
agent_context.db
agent_memory/

# Research sessions (user-specific)
research_sessions/

# Private/Personal manifests & training data (not tracked in git)
manifesti/Private/
!manifesti/Private/.gitkeep
training/Private/*
!training/Private/.gitkeep
!training/Private/*/.gitkeep

# Agent metadata (auto-generated from manifesti + API)
agents_meta.json

# Temp / generated files
sigma_studio/build_log.txt
sigma_studio/modules_meta.json
modules_meta.json
tasks.json

# Training job outputs (personal/study specific)
training/jobs/*

# Backbone AILO del motore Gradus (~600 MB, scaricato al primo run)
training/backbones/
!training/jobs/.gitkeep

# Temporary/downloaded user test datasets
training/datasets/hf_*
training/datasets/local_*
!training/datasets/.gitkeep

# Training python cache
training/__pycache__/
training/*/__pycache__/
!training/.gitkeep
!training/scripts/.gitkeep

# Unsloth compiled cache (auto-generated, user-specific)
unsloth_compiled_cache/

# Benchmark: dataset ufficiali scaricati da HuggingFace e dettaglio dei run.
# Sono artefatti rigenerabili (decine di MB per suite, uno JSONL per run);
# l'indice dei job resta versionato perche' e' piccolo e tiene lo storico.
training_lab/benchmark_cache/
training_lab/benchmark_runs/
# PID e porte dei servitori Ollama avviati da Sigma: stato di questa macchina.
training_lab/ollama_instances.json

# Notebooks / experiments
*.ipynb
sigma_studio/.build_stamp
.backups/*
.training/*
.training_lab/*.json
# ==============================================================================
# Dati di questa macchina, non della piattaforma
# ==============================================================================
# Tutto quello che nasce eseguendo Sigma — job, pesi, misure, cache — descrive
# *questo* computer e *queste* sessioni, non il progetto. Su un repo pubblico
# sono rumore per chi lo clona (e qualche centinaio di MB di storia in piu'),
# e portano con se' percorsi assoluti locali.

# Esecuzioni di training: script generati, checkpoint, pesi, log
training/jobs/*
!training/jobs/.gitkeep
# Pesi materializzati dagli import HuggingFace (gigabyte di hardlink e GGUF)
training/imports/
# Registro dei job: contiene percorsi assoluti di chi lo ha eseguito
training/training_jobs.json

# Dataset scaricati o importati dall'utente. I due curati del progetto
# (router e intent) restano versionati: sono contenuto, non dati di esecuzione.
training/datasets/*
!training/datasets/.gitkeep
!training/datasets/router_dataset.jsonl
!training/datasets/sigma_intent_dataset.jsonl

# Misure e stato del Training Lab
training_lab/autopilot/
training_lab/autopilot_state.json
training_lab/*.json

# Cache delle sessioni degli agenti
agent_tasks_cache.json
# Diario di lavoro personale
task_progress.md
# Output di calcoli locali
viz/peaks_*.json

# Modelli e pesi, ovunque finiscano
*.gguf
*.safetensors
*.bin
!**/tokenizer.bin
