# Dynamic Modules (downloaded from separate repositories)
/modules/
/core/modules/*
!/core/modules/__init__.py
!/core/modules/sigma_model_hub/
!/core/modules/sigma_model_hub/**
# La negazione qui sopra riapre TUTTO cio' che sta sotto sigma_model_hub,
# bytecode compreso: e' cosi' che sette .pyc sono finiti nel repository
# nonostante le regole __pycache__/ e *.pyc in cima al file. Le ultime regole
# vincono, quindi vanno riescluse qui.
/core/modules/sigma_model_hub/**/__pycache__/
/core/modules/sigma_model_hub/**/*.pyc
# Hardware Lab: non e' un modulo scaricabile come gli altri, e' il pannello che
# si adatta all'hardware della macchina su cui gira. Va versionato qui.
!/core/modules/sigma_hardware_lab/
!/core/modules/sigma_hardware_lab/**
/core/modules/sigma_hardware_lab/**/__pycache__/
/core/modules/sigma_hardware_lab/**/*.pyc
/sigma_studio/src/modules/*
!/sigma_studio/src/modules/registry.js
!/sigma_studio/src/modules/ModuleNotInstalled.jsx
!/sigma_studio/src/modules/sigma_model_hub/
!/sigma_studio/src/modules/sigma_model_hub/**
!/sigma_studio/src/modules/sigma_hardware_lab/
!/sigma_studio/src/modules/sigma_hardware_lab/**
data/marketplace_installed.json

# Tests & Coverage
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# Le quattro radici dei dati
#
# Ognuna ha una natura diversa e nessuna appartiene al repository:
#   data/       lavoro dell'utente: argomenti, note, immagini generate
#   config/     configurazione della macchina, contiene credenziali
#   var/        stato di runtime: task, cache, indici
#   store/      artefatti scaricati: modelli, shard, strumenti dell'engine
#
# config/ va ignorato PRIMA di spostarci dentro i file: finche' stavano sotto
# data/ erano coperti dalla riga qui sotto, e portarli fuori senza questa regola
# li avrebbe resi tracciabili — token di HuggingFace compreso.
# ==============================================================================
data/
!data/.gitkeep
config/
!config/.gitkeep
!config/config.example.json
!config/engine_overrides.json
var/
!var/.gitkeep
store/
!store/.gitkeep

# IDE & AI Assistants
.vscode/
.idea/
.claude/
.gemini/
.cursor/
.windsurf/
*.swp
*.swo
*~

# Debug / Temp test output & Logs
test_1M_output.txt
test_output.txt
*.tmp
*.log
*.pid

# Scratch (temporary workspace)
scratch/
!scratch/.gitkeep

# Pipeline definitions (user-specific)
collatz_pipeline.json

# Virtual Environment
.venv/
# Il kernel Rust NON sta in questo repository.
#
# Vive in un repository privato suo — `projects/sigma_engine_rust` ha il
# proprio `.git` e il proprio remote — e quando sara' pronto verra'
# distribuito solo compilato. Qui dentro non deve finire ne' il sorgente
# ne' il puntatore al commit: un gitlink senza `.gitmodules` dice a
# chiunque cloni che esiste qualcosa che non potra' mai prendere.
#
# Le regole piu' fini qui sotto valgono per le altre cartelle di progetto.
projects/sigma_engine_rust/

# Rust build targets and heavy assets in projects
projects/**/target/
projects/**/*.gguf
projects/**/*.bin
projects/**/*.safetensors
projects/**/weights/
